# Copy to insights.env (gitignored) and fill in for this machine.
#
# run_insights.sh refuses to run when insights.env is missing rather than falling
# back to a default. A wrong default would silently upload a usage report to the
# wrong host, and these three values are exactly the ones that must never re-enter
# the repo -- they were public on GitHub for three months before the history
# rewrite that removed them.

# SSH destination for the report upload, as user@host.
INSIGHTS_SSH_HOST="user@example.internal"

# Private key used for that host.
INSIGHTS_SSH_KEY="$HOME/.ssh/id_ed25519"

# Remote directory the report is copied into. No trailing slash.
INSIGHTS_REMOTE_DIR="/var/www/reports/example"
